  "decisions": [
    {
      "id": "o1",
      "statement": "Use local SQLite catalogue storage and OpenRouter inference; support Identify and Verify with six seeded products and adding manufacturer material. Source: owner app request and parent-confirmed interview, 16 October 2026.",
      "provenance": "owner",
      "date": "2026-10-16",
      "decider": "Shiva"
    },
    {
      "id": "d1",
      "statement": "Use photo queue plus side-by-side store/manufacturer comparison with evidence below; keep Catalogue and History secondary.",
      "provenance": "designer",
      "date": "2026-10-16",
      "decider": "design prototyper"
    },
    {
      "id": "d2",
      "statement": "Use neutral system typography, white/stone surfaces and restrained blue controls; use written qualitative confidence labels.",
      "provenance": "designer",
      "date": "2026-10-16",
      "decider": "design prototyper"
    },
    {
      "id": "a1",
      "statement": "Support light theme only in this local MVP; desktop 1440\u00d71000 and narrow 390\u00d7844 are representative target viewports.",
      "provenance": "assumption",
      "date": "2026-10-16",
      "decider": "design prototyper"
    }
  ],
  "simulated": [
    {
      "what": "Store input example and object results",
      "how": "Existing public P059 photo with invented filename, manually positioned illustrative boxes, fixed model/evidence/confidence results; production must use uploaded files and persisted inference output."
    },
    {
      "what": "Paid inference and retries",
      "how": "Timer and state switch only. Production must use metered OpenRouter requests and real job polling."
    },
    {
      "what": "Catalogue writes",
      "how": "Native form validation and preview-only save message; production must use SQLite and stored manufacturer material."
    },
    {
      "what": "History, timestamps, costs and allowance",
      "how": "Fixed sample rows and values; production must read persisted jobs and budget ledger."
    }
  ],
