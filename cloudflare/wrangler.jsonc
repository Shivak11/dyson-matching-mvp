{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "multiplier-photo-demo",
  "account_id": "22744e58d83f933700484b130caec4fb",
  "main": "worker.js",
  "compatibility_date": "2026-10-17",
  "workers_dev": true,
  "preview_urls": false,
  "vars": { "APP_ORIGIN": "https://multiplier-photo-demo.shiva-research11.workers.dev" },
  "containers": [{ "class_name": "PhotoDemo", "image": "registry.cloudflare.com/22744e58d83f933700484b130caec4fb/multiplier-photo-demo-photodemo@sha256:3274b538917da535d419356d981e2890e47a655c9a711a6a39f0ca948437a93f", "instance_type": "basic", "max_instances": 1 }],
  "durable_objects": { "bindings": [{ "name": "PHOTO_DEMO", "class_name": "PhotoDemo" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PhotoDemo"] }],
  "r2_buckets": [{ "binding": "STATE", "bucket_name": "multiplier-photo-demo-state" }],
  "observability": { "enabled": false }
}
