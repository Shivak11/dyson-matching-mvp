{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "multiplier-photo-demo",
  "main": "worker.js",
  "compatibility_date": "2026-10-17",
  "workers_dev": true,
  "preview_urls": false,
  "vars": { "APP_ORIGIN": "https://deployment-account-must-be-confirmed.invalid" },
  "containers": [{ "class_name": "PhotoDemo", "image": "./Dockerfile", "image_build_context": "..", "instance_type": "basic", "max_instances": 1 }],
  "durable_objects": { "bindings": [{ "name": "PHOTO_DEMO", "class_name": "PhotoDemo" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PhotoDemo"] }],
  "r2_buckets": [{ "binding": "STATE", "bucket_name": "multiplier-photo-demo-state" }],
  "observability": { "enabled": false }
}
